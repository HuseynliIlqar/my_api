{
  "info": {
    "name": "Earthquake API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://209.38.217.227:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Earthquakes",
      "item": [
        {
          "name": "Get All (paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/earthquakes?page=0&size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "earthquakes"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get All (filter by magnitude)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/earthquakes?page=0&size=20&minMag=5.0",
              "host": ["{{base_url}}"],
              "path": ["api", "earthquakes"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "minMag", "value": "5.0" }
              ]
            }
          }
        },
        {
          "name": "Get All (filter by place)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/earthquakes?page=0&size=20&place=Japan",
              "host": ["{{base_url}}"],
              "path": ["api", "earthquakes"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "place", "value": "Japan" }
              ]
            }
          }
        },
        {
          "name": "Get By ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/earthquakes/1"
          }
        },
        {
          "name": "Create Earthquake",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/earthquakes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"magnitude\": 6.2,\n  \"place\": \"10km N of Baku, Azerbaijan\",\n  \"depth\": 12.5,\n  \"latitude\": 40.51,\n  \"longitude\": 49.93,\n  \"type\": \"earthquake\",\n  \"status\": \"reviewed\"\n}"
            }
          }
        },
        {
          "name": "Update Earthquake",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/earthquakes/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"magnitude\": 5.8,\n  \"place\": \"15km N of Baku, Azerbaijan\",\n  \"depth\": 10.0,\n  \"latitude\": 40.55,\n  \"longitude\": 49.95,\n  \"type\": \"earthquake\",\n  \"status\": \"reviewed\"\n}"
            }
          }
        },
        {
          "name": "Delete Earthquake",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/earthquakes/1"
          }
        }
      ]
    }
  ]
}
